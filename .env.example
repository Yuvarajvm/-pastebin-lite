# Server-only production database connection (Neon PostgreSQL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional pooled Neon URL for Next.js/Vercel request traffic. Leave unset for non-Neon databases.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
# Dedicated, disposable database for the integration test suite.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/TEST_DATABASE?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=pastebin_lite_secure_neon_auth_cookie_secret_32_chars_min
NEON_AUTH_TRUSTED_ORIGIN=https://pastebin-lite.vercel.app

# Canonical public app URL used for share links (optional, falls back to Vercel production URL or request host)
NEXT_PUBLIC_APP_URL=https://pastebin-lite.vercel.app
